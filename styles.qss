/* 
   Estilos de Aplicación Web Oscura Premium - Ajustado al Mockup de Referencia
*/

/* General */
QWidget {
    background-color: #0f0f11; /* Negro profundo */
    color: #f4f4f5; /* Texto Zinc 100 */
    font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
    font-size: 13px;
}

/* Regla base para todos los botones: bordes definidos (edges) */
QPushButton {
    background-color: #27272a;
    color: #e4e4e7;
    border: 1px solid #3f3f46;
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: 600;
    font-size: 12px;
}

QPushButton:hover {
    background-color: #3f3f46;
    color: #ffffff;
    border: 1px solid #52525b;
}

QPushButton:pressed {
    background-color: #18181b;
    border: 1px solid #6366f1;
}

/* Barra de Navegación Superior */
QFrame#topNavBar {
    background-color: #18181b; /* Zinc 900 */
    border-bottom: 1px solid #27272a;
    min-height: 50px;
    max-height: 50px;
    padding: 0px 10px;
}

QLabel#appBrandIcon {
    background-color: #111715;
    border: 1px solid #34463c;
    border-radius: 7px;
    color: #a6dfc2;
    font-size: 19px;
    font-weight: bold;
}

QLabel#appBrandStation {
    color: #81958b;
    background: transparent;
    font-size: 8px;
    font-weight: bold;
    letter-spacing: 1px;
}

QLabel#appBrandName {
    color: #edf3ef;
    background: transparent;
    font-size: 14px;
    font-weight: 700;
}

QPushButton#navBtn {
    background-color: transparent;
    color: #a1a1aa;
    border: 1px solid #27272a;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: bold;
    font-size: 13px;
}

QPushButton#navBtn:hover {
    background-color: #27272a;
    color: #fafafa;
    border: 1px solid #3f3f46;
}

QPushButton#navBtn[active="true"] {
    background-color: #202923;
    color: #ffffff;
    border: 1px solid #547967;
}

/* Paneles del Contenedor (Misma tonalidad que el Mockup) */
QFrame#previewPanel, QFrame#libraryPanel {
    background-color: #1c1c1e; /* Gris oscuro del panel */
    border: 1px solid #2c2c2e;
    border-radius: 12px;
}

/* Cabecera del Preview */
QLabel#previewHeaderTitle {
    color: #71717a;
    font-size: 11px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    background: transparent;
}

QLabel#previewSongTitle {
    color: #ffffff;
    font-size: 18px;
    font-weight: bold;
    background: transparent;
    margin-top: 5px;
    margin-bottom: 5px;
}

/* Buscador Redondeado */
QLineEdit#searchBar {
    background-color: #27272a;
    border: 1px solid #3f3f46;
    border-radius: 20px;
    color: #ffffff;
    padding: 10px 18px;
    font-size: 14px;
}

QLineEdit#searchBar:focus {
    border: 1px solid #6366f1;
}

/* Listas de la biblioteca y de previsualización */
QListWidget {
    background-color: transparent;
    border: none;
    outline: 0;
}

QListWidget::item {
    background-color: transparent;
    padding: 0px;
    margin: 0px;
}

/* Separación entre tarjetas de previsualización */
QListWidget#previewList::item {
    margin-bottom: 6px;
}

/* Dialogo amplio para crear o editar cantos */
QFrame#songEditorHeader {
    background-color: #111815;
    border-bottom: 1px solid #29352f;
}

QFrame#songEditorMeta {
    background-color: #121916;
}

QFrame#songEditorFooter {
    background-color: #111815;
    border-top: 1px solid #29352f;
}

QLabel#songEditorIcon {
    color: #a6dfc2;
    background-color: #20352b;
    border: 1px solid #355846;
    border-radius: 6px;
    font-size: 19px;
}

QLabel#songEditorEyebrow,
QLabel#songEditorFieldLabel {
    color: #84968c;
    font-size: 9px;
    font-weight: bold;
    letter-spacing: 0.4px;
}

QLabel#songEditorTitle {
    color: #edf3ef;
    font-size: 17px;
    font-weight: 600;
}

QLabel#songEditorSectionTitle {
    color: #dce5e0;
    font-size: 13px;
    font-weight: 600;
}

QLabel#songEditorCount {
    color: #75867d;
    font-size: 10px;
    font-weight: normal;
}

QPushButton#songEditorCloseBtn,
QPushButton#songEditorCancelBtn {
    background-color: transparent;
    color: #9aa8a0;
    border: 1px solid #34413a;
    border-radius: 5px;
    padding: 8px 14px;
    font-size: 11px;
    font-weight: bold;
}

QPushButton#songEditorCloseBtn {
    padding: 0px;
    font-size: 18px;
}

QPushButton#songEditorCloseBtn:hover,
QPushButton#songEditorCancelBtn:hover {
    background-color: #202b25;
    color: #edf3ef;
}

QPushButton#songEditorSaveBtn {
    background-color: #a6dfc2;
    color: #102018;
    border: 1px solid #a6dfc2;
    border-radius: 5px;
    padding: 9px 16px;
    font-size: 11px;
    font-weight: bold;
}

QPushButton#songEditorSaveBtn:hover:enabled {
    background-color: #c1ecd4;
}

QPushButton#songEditorSaveBtn:disabled {
    background-color: #2a3730;
    color: #718078;
    border-color: #34413a;
}

QPushButton#songEditorAddSectionBtn {
    background-color: #17211c;
    color: #c7d7ce;
    border: 1px solid #34463c;
    border-radius: 5px;
    padding: 7px 10px;
    font-size: 10px;
    font-weight: 600;
}

QPushButton#songEditorAddSectionBtn:hover {
    background-color: #20352b;
    border-color: #5da98c;
}

QFrame#songEditorPreviewPanel {
    background-color: #121916;
    border: 1px solid #293830;
    border-radius: 6px;
}

QFrame#songPreviewCanvas {
    background-color: #0c1511;
    border: 1px solid #304239;
    border-radius: 5px;
}

QLabel#songPreviewSection {
    color: #83d2b1;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 0.6px;
    background: transparent;
}

QLabel#songPreviewLyrics {
    color: #f0eee7;
    font-family: "Times New Roman", Georgia, serif;
    font-size: 23px;
    font-weight: 600;
    background: transparent;
}

QLabel#songPreviewFooter {
    color: #819087;
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.4px;
    background: transparent;
}

/* Lista compacta y cronológica del Guion */
QListWidget#guionList {
    background: transparent;
    border: none;
}

QListWidget#guionList::item {
    background: transparent;
    border: none;
    padding: 0px;
}

QFrame#guionRow {
    background: transparent;
    border-bottom: 1px solid #242d29;
}

QFrame#guionRow:hover,
QFrame#guionRow[active="true"] {
    background-color: #18201d;
}

QFrame#guionRow[active="true"] {
    border-left: 2px solid #62c7aa;
}

QLabel#guionOrder {
    color: #64746c;
    font-size: 10px;
    background: transparent;
}

QLabel#guionTypeIcon {
    color: #a9bbb2;
    background-color: #242e29;
    border: 1px solid #34413a;
    border-radius: 4px;
    font-size: 14px;
}

QLabel#guionTypeLabel {
    color: #80a08f;
    font-size: 9px;
    font-weight: bold;
    background: transparent;
}

QLabel#guionItemTitle {
    color: #e8efeb;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
}

QLabel#guionItemDetail {
    color: #78877f;
    font-size: 10px;
    background: transparent;
}

QPushButton#guionRemoveBtn {
    background: transparent;
    color: #718078;
    border: 1px solid transparent;
    border-radius: 4px;
    font-size: 17px;
    padding: 0px;
}

QPushButton#guionRemoveBtn:hover {
    color: #fca5a5;
    background-color: #3a201f;
    border-color: #6b3835;
}

QLabel#guionRowArrow {
    color: #607068;
    font-size: 20px;
    background: transparent;
}

/* Selectores y vista de versículos del módulo Biblia */
QLabel#bibleSelectorLabel {
    color: #81958b;
    font-size: 9px;
    font-weight: bold;
    letter-spacing: 0.5px;
    background: transparent;
}

QComboBox#bibleSelectorCombo {
    background-color: #111715;
    color: #edf3ef;
    border: 1px solid #2d3b34;
    border-radius: 5px;
    min-height: 34px;
    padding: 2px 9px;
    font-size: 12px;
    font-weight: 600;
}

QComboBox#bibleSelectorCombo:hover,
QComboBox#bibleSelectorCombo:focus {
    border-color: #5da98c;
}

QComboBox#bibleSelectorCombo QAbstractItemView {
    background-color: #171e1b;
    color: #edf3ef;
    selection-background-color: #244235;
    selection-color: #ffffff;
}

QLabel#bibleBookSection {
    color: #79cbb0;
    font-size: 9px;
    font-weight: bold;
    letter-spacing: 0.5px;
    background: transparent;
}

QLabel#bibleChapterHeading {
    color: #f0f3f1;
    font-family: "Times New Roman", Georgia, serif;
    font-size: 19px;
    font-weight: bold;
    background: transparent;
}

QLabel#bibleVerseCount {
    color: #71847a;
    font-size: 10px;
    background: transparent;
}

QLineEdit#bibleVerseSearch {
    background-color: #111715;
    color: #edf3ef;
    border: 1px solid #2d3b34;
    border-radius: 5px;
    min-height: 30px;
    padding: 3px 9px;
    font-size: 11px;
}

QLineEdit#bibleVerseSearch:focus {
    border-color: #5da98c;
}

QComboBox#bibleVerseCombo {
    background-color: #111715;
    color: #edf3ef;
    border: 1px solid #2d3b34;
    border-radius: 5px;
    min-width: 130px;
    min-height: 30px;
    padding: 3px 8px;
    font-size: 11px;
}

QComboBox#bibleVerseCombo:hover,
QComboBox#bibleVerseCombo:focus {
    border-color: #5da98c;
}

QListWidget#bibleVerseList {
    background-color: transparent;
    border: none;
}

QListWidget#bibleVerseList::item {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
}

QListWidget#bibleVerseList::item:hover {
    background-color: #17211c;
    border-color: #2e4639;
}

QListWidget#bibleVerseList::item:selected {
    background-color: #1b2b25;
    border-color: #4a9b7c;
}

QWidget#bibleVersePreviewRow {
    background-color: #151d19;
    border: 1px solid #283830;
    border-radius: 5px;
}

QWidget#bibleVersePreviewRow:hover {
    background-color: #19241e;
    border-color: #3a604d;
}

QWidget#bibleVersePreviewRow[selected="true"] {
    background-color: #1b2b25;
    border-color: #4a9b7c;
}

QLabel#bibleVerseNumber {
    color: #70d7bd;
    font-size: 11px;
    font-weight: bold;
    background: transparent;
}

QLabel#bibleVerseText {
    color: #dce5e0;
    font-family: "Times New Roman", Georgia, serif;
    font-size: 13px;
    background: transparent;
}

/* Botón estilo píldora para agregar al guión */
QPushButton#addToGuionBtn {
    background-color: #2563eb;
    color: #ffffff;
    border: 1px solid #3b82f6;
    border-radius: 14px;
    padding: 6px 14px;
    font-size: 11px;
    font-weight: bold;
}

QPushButton#addToGuionBtn:hover {
    background-color: #1d4ed8;
    border: 1px solid #60a5fa;
}

/* Controles de salida */
QPushButton#subtleCtrlBtn {
    background-color: #27272a;
    color: #e4e4e7;
    border: 1px solid #3f3f46;
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: bold;
    font-size: 11px;
}

QPushButton#subtleCtrlBtn:hover {
    background-color: #3f3f46;
    color: #ffffff;
    border: 1px solid #52525b;
}

QPushButton#subtleCtrlBtnDanger {
    background-color: #451a1a;
    color: #fca5a5;
    border: 1px solid #7f1d1d;
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: bold;
    font-size: 11px;
}

QPushButton#subtleCtrlBtnDanger:hover {
    background-color: #7f1d1d;
    border: 1px solid #991b1b;
}

/* Vista de salida de proyección nativa */
QFrame#projectionOutputFrame {
    background-color: #000000;
    border: 2px solid #27272a;
    border-radius: 8px;
}

QLabel#outputImageThumbnail {
    background-color: #111715;
    border: 2px solid #d5e0da;
    border-radius: 6px;
}

QLabel#projectionLabelTitle {
    color: #52525b;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 0.5px;
    background: transparent;
}

QLabel#projectionFooterTitle {
    color: #71717a;
    font-size: 12px;
    font-weight: 500;
    background: transparent;
}

QPushButton#helpRoundBtn {
    background-color: #27272a;
    color: #a1a1aa;
    border: 1px solid #3f3f46;
    border-radius: 12px;
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
    font-weight: bold;
    font-size: 11px;
}

QPushButton#helpRoundBtn:hover {
    background-color: #3f3f46;
    color: #ffffff;
    border: 1px solid #52525b;
}

/* Panel lateral de salidas y controles de proyección */
QFrame#projectionWorkspaceFrame {
    background-color: #101614;
    border: 1px solid #2a3631;
    border-radius: 8px;
}

QFrame#projectionControlPanel {
    background-color: #141a17;
    border: 1px solid #27342e;
    border-radius: 6px;
}

QLabel#projectionSectionLabel {
    color: #9aaca3;
    font-size: 11px;
    font-weight: bold;
    background: transparent;
}

QFrame#projectionScreenRow {
    background-color: #171e1b;
    border: 1px solid #29342f;
    border-radius: 5px;
}

QFrame#projectionScreenRow[active="true"] {
    background-color: #182820;
    border: 1px solid #315c4a;
}

QLabel#projectionScreenIcon {
    color: #b7c8c0;
    background-color: #252e2a;
    border: 1px solid #34413a;
    border-radius: 5px;
    font-size: 16px;
}

QLabel#projectionScreenName {
    color: #edf3ef;
    font-size: 11px;
    font-weight: bold;
    background: transparent;
}

QLabel#projectionScreenDetails {
    color: #8d9d95;
    font-size: 9px;
    background: transparent;
}

QCheckBox#projectionScreenToggle {
    background: transparent;
    spacing: 0;
}

QCheckBox#projectionScreenToggle::indicator {
    width: 34px;
    height: 18px;
    background-color: #3a4440;
    border: 1px solid #56625c;
    border-radius: 9px;
}

QCheckBox#projectionScreenToggle::indicator:checked {
    background-color: #62c7aa;
    border-color: #62c7aa;
}

QFrame#projectionControlsDivider {
    color: #293630;
    background-color: #293630;
    border: none;
    max-height: 1px;
}

QPushButton#projectionActionBtn {
    background-color: #1b2420;
    color: #e4ece8;
    border: 1px solid #34433b;
    border-radius: 5px;
    min-height: 40px;
    padding: 7px 6px;
    font-size: 11px;
}

QPushButton#projectionActionBtn:hover {
    background-color: #24312b;
    border-color: #528b74;
}

QToolButton#projectionTileBtn {
    background-color: #141a17;
    color: #dce5e0;
    border: 1px solid #34413a;
    border-radius: 5px;
    min-width: 48px;
    min-height: 56px;
    padding: 4px 2px;
    font-size: 9px;
    font-weight: 600;
    icon-size: 18px;
}

QToolButton#projectionTileBtn:hover {
    background-color: #202b25;
    border-color: #528b74;
}

QPushButton#projectionDangerBtn {
    background-color: #351d1b;
    color: #ffc0b8;
    border: 1px solid #78433c;
    border-radius: 5px;
    min-height: 44px;
    padding: 8px;
    font-size: 12px;
    font-weight: bold;
}

QPushButton#projectionDangerBtn:hover {
    background-color: #512622;
    border-color: #a45b50;
}

QPushButton#fontStepBtn {
    background-color: #1b2420;
    color: #e4ece8;
    border: 1px solid #34433b;
    border-radius: 5px;
    min-width: 36px;
    min-height: 34px;
    font-size: 17px;
    font-weight: bold;
}

QPushButton#fontStepBtn:hover {
    background-color: #24312b;
    border-color: #528b74;
}

QPushButton#fontSizeIndicatorBtn {
    background-color: transparent;
    color: #70d7bd;
    border: none;
    min-width: 24px;
    min-height: 34px;
    padding: 0px;
    font-size: 11px;
    font-weight: bold;
}

/* Scrollbars Oscuros */
QScrollBar:vertical {
    border: none;
    background: #18181b;
    width: 6px;
    margin: 0px;
    border-radius: 3px;
}

QScrollBar::handle:vertical {
    background: #3f3f46;
    min-height: 20px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background: #52525b;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

/* Botón de importación de imágenes */
QPushButton#importBtn {
    background-color: #2563eb;
    color: #ffffff;
    border: 1px solid #3b82f6;
    border-radius: 18px;
    padding: 8px 18px;
    font-weight: bold;
    font-size: 13px;
}

QPushButton#importBtn:hover {
    background-color: #1d4ed8;
    border: 1px solid #60a5fa;
}

/* QSplitter Handles */
QSplitter::handle {
    background-color: #27272a;
}
QSplitter::handle:hover {
    background-color: #3f3f46;
}
QSplitter::handle:vertical {
    height: 4px;
}
QSplitter::handle:horizontal {
    width: 4px;
}
